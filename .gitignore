# Local data: retain root README and second-level directory placeholders
/data/**
!/data/*/
!/data/*/.gitkeep
!/data/README.md

# Model weights: retain root README and second-level directory placeholders
/models/**
!/models/*/
!/models/*/.gitkeep
!/models/README.md
